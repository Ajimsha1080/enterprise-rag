{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Name of the App Service"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "S1",
        "S2",
        "S3",
        "P1V2",
        "P2V2",
        "P3V2"
      ],
      "metadata": {
        "description": "SKU for App Service"
      }
    },
    "dockerImage": {
      "type": "string",
      "defaultValue": "rag-api:latest",
      "metadata": {
        "description": "Docker image name"
      }
    },
    "groqApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "Groq API key"
      }
    },
    "langsmithApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "LangSmith API key"
      }
    },
    "alwaysOn": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Always on setting for App Service"
      }
    }
  },
  "variables": {
    "appServiceName": "[concat('app-', parameters.appName, '-', uniqueString(resourceGroup().id))]",
    "appServicePlanName": "[concat('plan-', parameters.appName, '-', uniqueString(resourceGroup().id))]",
    "appInsightsName": "[concat('appi-', parameters.appName, '-', uniqueString(resourceGroup().id))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables.appServicePlanName]",
      "location": "[parameters.location]",
      "sku": {
        "name": "[parameters.sku]",
        "tier": "[split(parameters.sku, '')[0]]",
        "size": "[substring(parameters.sku, 1, length(parameters.sku))]"
      },
      "properties": {
        "reserved": false,
        "perSiteScaling": false,
        "isXenon": false,
        "hyperV": false,
        "targetWorkerCount": 0,
        "targetWorkerSizeId": 0
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[variables.appServiceName]",
      "location": "[parameters.location]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables.appServicePlanName)]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables.appServicePlanName)]",
        "siteConfig": {
          "linuxFxVersion": "DOCKER|"[parameters.dockerImage]"",
          "alwaysOn": "[parameters.alwaysOn]",
          "appSettings": [
            {
              "name": "DOCKER_CUSTOM_IMAGE_NAME",
              "value": "[parameters.dockerImage]"
            },
            {
              "name": "RAG_DATA_DIR",
              "value": "/app/data"
            },
            {
              "name": "RAG_PERSIST_DIR",
              "value": "/app/faiss_store"
            },
            {
              "name": "RAG_EMBEDDING_MODEL",
              "value": "all-MiniLM-L6-v2"
            },
            {
              "name": "RAG_LLM_MODEL",
              "value": "llama-3.3-70b-versatile"
            },
            {
              "name": "RAG_DEFAULT_TOP_K",
              "value": "5"
            },
            {
              "name": "RAG_AUTO_BUILD_INDEX",
              "value": "true"
            },
            {
              "name": "GROQ_API_KEY",
              "value": "[parameters.groqApiKey]"
            },
            {
              "name": "LANGSMITH_API_KEY",
              "value": "[parameters.langsmithApiKey]"
            },
            {
              "name": "WEBSITE_WEB_SOCKET",
              "value": "false"
            },
            {
              "name": "WEBSITE_RUN_FROM_PACKAGE",
              "value": "1"
            },
            {
              "name": "SCM_BUILD_ARGS",
              "value": "--no-cache"
            }
          ],
          "httpLoggingEnabled": true,
          "detailedErrorLoggingEnabled": true,
          "requestTracingEnabled": true,
          "experiments": {
            "frameworks": {
              "enabled": false
            }
          }
        },
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "clientCertEnabled": false,
        "hostNames": [],
        "repositorySiteName": "[variables.appServiceName]",
        "deployment": {
          "scmType": "LocalGit",
          "enabled": false
        },
        "keyVaultReferenceIdentity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', concat('id-', variables.appServiceName))]"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2022-04-01",
      "name": "[variables.appInsightsName]",
      "location": "[parameters.location]",
      "kind": "web",
      "properties": {
        "application_Type": "web",
        "ApplicationId": "[variables.appServiceName]",
        "DisableIpMasking": false,
        "SamplingPercentage": 100,
        "Force hra": false,
        "IngestionMode": "Default",
        "Request_Source": "I",
        "Cap": null,
        "HockeyAppId": null,
        "HockeyAppSecret": null
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables.appServiceName)]"
      ]
    }
  ],
  "outputs": {
    "appServiceUrl": {
      "type": "string",
      "value": "[reference(variables.appServiceName).defaultHostName]"
    },
    "appServiceName": {
      "type": "string",
      "value": "[variables.appServiceName]"
    }
  }
}